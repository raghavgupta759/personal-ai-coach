# Copy to .env.local or .env and fill values locally.
# NEVER commit a real .env file or put server secrets in NEXT_PUBLIC_* variables.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/personal_ai_coach
AUTH_SECRET=replace_with_a_long_random_secret
APP_BASE_URL=http://localhost:3000

# Gemini is called from server-side code only.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional web search provider. Implement an adapter and respect provider terms.
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=

# Optional private object storage (fill only if using S3-compatible storage).
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Optional speech-to-text/text-to-speech provider; browser APIs can be used as fallback.
SPEECH_PROVIDER=browser
SPEECH_API_KEY=

# Upload/security configuration
MAX_UPLOAD_MB=10
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Do not store real secrets in this template.
